{
  "name": "silue",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run tauri -w @silue/app -- dev",
    "build": "npm run tauri -w @silue/app -- build",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "check:rust": "cargo fmt --manifest-path packages/app/src-tauri/Cargo.toml --check && cargo clippy --manifest-path packages/app/src-tauri/Cargo.toml -- -D warnings",
    "verify": "npm run typecheck && npm run lint && npm test && npm run verify-notes",
    "verify-agent-note-tree": "node .agents/skills/write-notes-like-deepseek/scripts/verify-agent-note-tree.ts",
    "verify-agent-note-format": "node .agents/skills/write-notes-like-deepseek/scripts/verify-agent-note-format.ts",
    "verify-archived": "node .agents/skills/write-notes-like-deepseek/scripts/verify-archived-agent-notes.ts",
    "verify-notes": "npm run verify-agent-note-tree && npm run verify-agent-note-format && npm run verify-archived",
    "archive-agent-note": "node .agents/skills/write-notes-like-deepseek/scripts/archive-agent-note.ts",
    "init-board": "node .agents/skills/write-notes-like-deepseek/scripts/build-board.ts --init board.html \"Silue 决策看板\""
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
